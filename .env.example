API_PORT=4000
COOKIE_SECURE=false

# Aiven service connection details. Copy this file to .env and fill in your values.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=25232
DB_USER=avnadmin
DB_PASSWORD=paste-your-aiven-password-here
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_CA=database/ca.pem
# For Vercel, add the base64 contents as the DB_SSL_CA_BASE64 environment variable.

# Admin login for the private dashboard. Choose your own values in .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-private-admin-password
